{
    "jsonid": "input_profile",
    "controller_type": "knuckles",
    "device_class": "TrackedDeviceClass_Controller",
    "resource_root": "padvr",
    "driver_name": "padvr",
    "input_bindingui_mode": "controller_handed",
    "input_bindingui_left": { "image": "" },
    "input_bindingui_right": { "image": "" },
    "input_source": {
        "/input/trigger": {
            "type": "trigger",
            "click": true,
            "value": true,
            "binding_image_point": [0, 0],
            "order": 1
        },
        "/input/system": {
            "type": "button",
            "click": true,
            "binding_image_point": [0, 0],
            "order": 2
        },
        "/input/thumbstick": {
            "type": "joystick",
            "click": true,
            "binding_image_point": [0, 0],
            "order": 3
        },
        "/input/joystick": {
            "type": "joystick",
            "click": true,
            "binding_image_point": [0, 0],
            "order": 4
        },
        "/pose/raw": {
            "type": "pose"
        }
    },
    "default_bindings": [
        { "controller_type": "knuckles", "binding_url": "padvr_bindings.json" }
    ]
}
